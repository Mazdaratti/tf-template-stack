############################################
# backend.tf.example (DOCUMENTATION ONLY)
#
# In this template, the real backend file is generated automatically by:
#   bootstrap/dev
#
# After running bootstrap, you will get:
#   envs/dev/backend.tf
#
# Do NOT commit backend.tf (it is an environment-specific artifact).
############################################

terraform {
  backend "s3" {
    # Generated by bootstrap/dev (module.remote_backend)
    bucket         = "REPLACE_ME_STATE_BUCKET_NAME"
    dynamodb_table = "REPLACE_ME_LOCK_TABLE_NAME"

    # Example settings
    key    = "terraform.tfstate"
    region = "eu-central-1"
  }
}

