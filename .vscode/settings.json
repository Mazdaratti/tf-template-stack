{
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "[hcl]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "terraform.experimentalFeatures.validateOnSave": true,
  "terraform.lintPath": "tflint",
  "terraform.lintOnSave": true,
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/.terraform": false,
    "**/.terraform.lock.hcl": false,
    "*.tfstate": false,
    "*.tfstate.*": false
  },
  "search.exclude": {
    "**/.terraform": true,
    "**/node_modules": true,
    "**/.tflint.d": true
  },
  // --- AI setup: Windsurf inline suggestions, Copilot chat only ---
  "editor.inlineSuggest.enabled": true,

  // IMPORTANT: make sure you do NOT suppress Codeium/Windsurf here.
  // If you previously had "codeium.codeium" in this setting, remove it.
  "editor.inlineSuggest.suppressSuggestions": false,

  // Disable Copilot inline completions everywhere (Chat still works)
  "github.copilot.enable": {
    "*": false
  },

  // Extra safety (some versions still read this)
  "github.copilot.inlineSuggest.enable": false
}

