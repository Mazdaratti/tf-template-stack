{
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "[hcl]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform"
  },
  "terraform.experimentalFeatures.validateOnSave": true,
  "terraform.lintPath": "tflint",
  "terraform.lintOnSave": true,
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/.terraform": false,
    "**/.terraform.lock.hcl": false,
    "*.tfstate": false,
    "*.tfstate.*": false
  },
  "search.exclude": {
    "**/.terraform": true,
    "**/node_modules": true,
    "**/.tflint.d": true
  }
}
