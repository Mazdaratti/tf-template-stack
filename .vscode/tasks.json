{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terraform: Format (repo)",
      "type": "shell",
      "command": "terraform",
      "args": ["fmt", "-recursive"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TFLint: Lint (repo)",
      "type": "shell",
      "command": "tflint",
      "args": ["--recursive"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Generate README.md (repo)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Env dev README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/envs/dev" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Env stage README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/envs/stage" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Env prod README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/envs/prod" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Module vpc README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/modules/vpc" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Module alb README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/modules/alb" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Module ecs-service README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/modules/ecs-service" },
      "problemMatcher": []
    },
    {
      "label": "Terraform (dev): Init",
      "type": "shell",
      "command": "terraform",
      "args": ["init"],
      "options": {
        "cwd": "${workspaceFolder}/envs/dev"
      },
      "problemMatcher": []
    },
    {
      "label": "Terraform (dev): Validate",
      "type": "shell",
      "command": "terraform",
      "args": ["validate"],
      "options": {
        "cwd": "${workspaceFolder}/envs/dev"
      },
      "problemMatcher": []
    },
    {
      "label": "Terraform (dev): Plan",
      "type": "shell",
      "command": "terraform",
      "args": ["plan", "-var-file=dev.tfvars"],
      "options": {
        "cwd": "${workspaceFolder}/envs/dev"
      },
      "problemMatcher": []
    }
  ]
}


