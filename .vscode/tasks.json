{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Terraform: Format (repo)",
      "type": "shell",
      "command": "terraform",
      "args": ["fmt", "-recursive"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TFLint: Lint (repo)",
      "type": "shell",
      "command": "tflint",
      "args": ["--recursive"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "TFLint: Lint (current folder)",
      "type": "shell",
      "command": "tflint",
      "args": [],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Generate README.md (repo)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Env dev README (inject)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${workspaceFolder}/envs/dev" },
      "problemMatcher": []
    },
    {
      "label": "terraform-docs: Generate README (current folder)",
      "type": "shell",
      "command": "terraform-docs",
      "args": ["markdown", "table", ".", "--output-file", "README.md", "--output-mode", "inject"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": []
    },
    {
      "label": "Terraform: Init (current folder)",
      "type": "shell",
      "command": "terraform",
      "args": ["init", "-input=false"],
      "options": { "cwd": "${fileDirname}"
      },
      "problemMatcher": []
    },
    {
      "label": "Terraform: Validate (current folder)",
      "type": "shell",
      "command": "terraform",
      "args": ["validate"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": []
    },
    {
      "label": "Terraform: Plan (current folder)",
      "type": "shell",
      "command": "terraform",
        "args": ["plan"],
        "options": { "cwd": "${fileDirname}" },
        "problemMatcher": []
      }
    ]
}


